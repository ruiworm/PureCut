{
  "name": "purecut",
  "version": "0.9.10",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "electron": "electron .",
    "desktop": "electron electron/desktop_runner.js",
    "studio": "python scripts/web_studio.py 8765",
    "pack:dir": "electron-builder --dir",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "ffmpeg-static": "^5.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "ffmpeg-static",
      "@ffprobe-installer/ffprobe"
    ]
  },
  "build": {
    "appId": "com.purecut.app",
    "productName": "PureCut",
    "npmRebuild": false,
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**",
      "node_modules/ffmpeg-static/**",
      "node_modules/@ffprobe-installer/**"
    ],
    "afterPack": "./electron/after-pack.cjs",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/@ffprobe-installer/**"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video",
      "identity": null,
      "icon": "electron/icon.png"
    },
    "dmg": {
      "format": "UDBZ"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "electron/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  }
}
